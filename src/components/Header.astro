---
const isProjectPage = Astro.url.pathname !== "/";
---

<header class="header reveal">

    <a
        href="/"
        class="logo"
        aria-label="Go to homepage"
    >
        PH
    </a>

    <nav class="navigation">

        {
            isProjectPage ? (

                <>

                    <a href="/">
                        ← Portfolio
                    </a>

                    <a
                        href="/cv/Pavlo_Hlukhov_CV.pdf"
                        target="_blank"
                        rel="noopener"
                    >
                        CV
                    </a>

                </>

            ) : (

                <>

                    <a href="#about">
                        About
                    </a>

                    <a href="#projects">
                        Projects
                    </a>

                    <a href="#contact">
                        Contact
                    </a>

                    <a
                        href="/cv/Pavlo_Hlukhov_CV.pdf"
                        target="_blank"
                        rel="noopener"
                    >
                        CV
                    </a>

                </>

            )
        }

    </nav>

</header>