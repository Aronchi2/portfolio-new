---
const isProjectPage = Astro.url.pathname !== "/";
---

<header class="header reveal">

    <a
        href="/"
        class="logo"
        aria-label="Go to homepage"
    >
        PH
    </a>

    <nav class="navigation">

        {
            isProjectPage ? (

                <a href="/">
                    ← Portfolio
                </a>

            ) : (

                <>
                    <a href="#about">
                        About
                    </a>

                    <a href="#projects">
                        Projects
                    </a>

                    <a href="#contact">
                        Contact
                    </a>
                </>

            )
        }

    </nav>

</header>