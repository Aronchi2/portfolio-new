---
import ProjectGallery from "./ProjectGallery.astro";

const { project } = Astro.props;
---

<main class="project-page">

  <!-- HERO -->

  <section class={`project-hero ${project.heroClass ?? ""}`}>
    <img
      src={project.cover}
      alt={project.title}
    />
  </section>

  <!-- INFO -->

  <section class="project-info reveal">
    <p>{project.category}</p>

    <h1>{project.title}</h1>

    <p>{project.description}</p>
  </section>

  <!-- RENDER GALLERY -->

  <section class="gallery reveal">
    <ProjectGallery images={project.gallery} />
  </section>

  <!-- DOCUMENTATION -->

  <section class="documentation reveal">

    <p class="section-label">
      Technical Documentation
    </p>

    <h2>
      Documentation Highlights
    </h2>

    <p class="section-description">
      Selected drawings from the complete ArchiCAD documentation package
      prepared for project implementation.
    </p>

    <div class="drawing">

      <div class="drawing-info">

        <p>{project.featuredDrawing.number}</p>

        <h3>{project.featuredDrawing.title}</h3>

        <span>
          {project.featuredDrawing.description}
        </span>

      </div>

      <div class="drawing-image">

        <img
          src={project.featuredDrawing.image}
          alt={project.featuredDrawing.title}
        />

      </div>

    </div>

    <h2 class="gallery-title">
      Documentation Gallery
    </h2>

    <div class={`docs-grid ${project.docsClass ?? ""}`}>

      {
        project.documentation.map((doc) => (

          <a
            class="doc-card"
            href={doc.src}
            data-pswp-width="2000"
            data-pswp-height="1400"
            target="_blank"
          >

            <img
              src={doc.src}
              alt={doc.title}
              loading="lazy"
            />

            <h3>{doc.title}</h3>

          </a>

        ))
      }

    </div>

  </section>

  
   {
  project.nextProject && (

    <a
      href={project.nextProject.href}
      class="next-arrow"
      aria-label={`Next project: ${project.nextProject.title}`}
    >

      <span class="next-text">
        {project.nextProject.title}
      </span>

      <span class="next-circle">
        →
      </span>

    </a>

  )
}

</main>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  const lightbox = new PhotoSwipeLightbox({
    gallery: ".docs-grid",
    children: "a",
    pswpModule: () => import("photoswipe"),
  });

  lightbox.init();
</script>

<style>
.doc-card{
    display:flex;
    flex-direction:column;
    align-items:center;
    text-decoration:none;
    color:inherit;
}

.doc-card img{
    width:100%;
    border-radius:16px;
    transition:.25s ease;
}

.doc-card:hover img{
    transform:translateY(-3px);
}

.doc-card h3{
    margin-top:18px;
    text-align:center;
    font-size:1rem;
    font-weight:500;
    color:#111;
}
</style>