---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

import Projects from "../components/Projects.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Pavlo Hlukhov | Technical Documentation Specialist"
    description="Portfolio of ArchiCAD technical drawings, BIM modelling and working documentation for interior design projects."
>

    <Header />

    <main>

        <section id="hero" class="reveal">

            <div class="hero-left">

                <span class="hero-tag">
                    ARCHICAD • TECHNICAL DRAWINGS • BIM
                </span>

                <h1>
                    Technical Drawings
                    <br />
                    for Interior
                    <br />
                    Design
                </h1>

                <p>
                    I develop complete technical documentation for interior design
                    projects, transforming approved concepts into coordinated
                    ArchiCAD working drawings for accurate construction and
                    implementation.
                </p>

                <div class="hero-buttons">

                    <a href="#projects" class="btn-dark">
                        View Projects
                    </a>

                    <a
                        href="/cv/Pavlo_Hlukhov_CV.pdf"
                        target="_blank"
                        download
                        class="btn-light"
                    >
                        Download CV
                    </a>

                </div>

            </div>

            <div class="hero-right">

                <img
                    src="/profile.jpg"
                    alt="Pavlo Hlukhov"
                />

            </div>

        </section>

        <Projects />

        <About />

        <Contact />

        <Footer />

    </main>

</Layout>