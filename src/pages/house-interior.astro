---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProjectPage from "../components/ProjectPage.astro";

const project = {
  category: "Residential Interior",

  title: "House Interior",

  description:
    "A modern residential interior developed in ArchiCAD with complete BIM modelling and technical documentation for construction.",

  cover: "/projects/house/cover.jpg",

  docsClass: "five-docs",

 fullDocumentation: "https://drive.google.com/file/d/1KFYwd9mBN0rnTDkW2ZG8rcteuXjgY2Lx/view",

  gallery: [
    {
      src: "/projects/house/living.jpg",
      alt: "Living Room",
    },
    {
      src: "/projects/house/dining.jpg",
      alt: "Dining Room",
    },
    {
      src: "/projects/house/kitchen.jpg",
      alt: "Kitchen",
    },
    {
      src: "/projects/house/bedroom.jpg",
      alt: "Bedroom",
    },
    {
      src: "/projects/house/bathroom.jpg",
      alt: "Bathroom",
    },
  ],

  featuredDrawing: {
    number: "01",

    title: "Furniture Layout",

    description:
      "Furniture placement and dimensions coordinated with the BIM model.",

    image: "/projects/house/documentation/furniture-layout.jpg",
  },

  documentation: [
    {
      src: "/projects/house/documentation/lighting-plan.jpg",
      title: "Lighting Plan",
    },
    {
      src: "/projects/house/documentation/ceiling-plan.jpg",
      title: "Ceiling Plan",
    },
    {
      src: "/projects/house/documentation/electrical-plan.jpg",
      title: "Electrical Plan",
    },
    {
      src: "/projects/house/documentation/bathroom-elevation.jpg",
      title: "Bathroom Elevation",
    },
    {
      src: "/projects/house/documentation/axonometry.jpg",
      title: "Furniture Axonometry",
    },
  ],

  nextProject: {
    title: "Minimal Apartment",
    href: "/minimal-apartment",
  },
};

---

<Layout
  title="House Interior | ArchiCAD Technical Documentation"
  description="Technical drawings, BIM model and complete ArchiCAD documentation for a modern house interior project."
>

  <Header />

  <ProjectPage project={project} />

</Layout>